# ---- Database (TiDB Cloud in production, plain MySQL locally) ----
# TiDB Cloud: cluster -> Connect -> "General" shows these values.
DB_HOST=XXXXX
DB_PORT=4000
DB_USER=XXXXX
DB_PASSWORD=XXXXX
DB_NAME=urvi_tours
DB_SSL=true
DATABASE_URL="mysql://XXXXX:XXXXX@XXXXX:4000/urvi_tours"
# Local MySQL instead:
#   DB_HOST=127.0.0.1  DB_PORT=3306  DB_USER=root  DB_PASSWORD=XXXXX  DB_SSL=false
# The database and the tables (cars, inquiries, notes) are created automatically on first start.

# ---- Admin login (only this email + password can open /admin) ----
# Put the real values in your local .env / Render environment, not in git.
ADMIN_EMAIL=XXXXX
ADMIN_PASSWORD=XXXXX
JWT_SECRET=XXXXX

# ---- CORS: your Vercel site URL(s), comma separated, no trailing slash ----
# Local: http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Telegram alerts (optional but recommended) ----
TELEGRAM_BOT_TOKEN=XXXXX
TELEGRAM_CHAT_ID=XXXXX

# ---- Render or local service port ----
PORT=4000
